# Production: copy this file (with values filled in) into the ENV_FILE GitHub secret
# (see README). Vite bakes VITE_* into dist/ at build time — not read from the server at runtime.

# Backend API URL (leave empty in dev to use Vite proxy to localhost:8080)
VITE_API_BASE_URL=

# Obscure ops sign-in path (default /access) — not linked from the public homepage
# VITE_ADMIN_SIGN_IN_PATH=/access

# Latest APK from GitHub releases (public repo)
# VITE_APP_GITHUB_REPO=themobileprof/momlaunchpad-app
# VITE_GITHUB_API_BASE_URL=https://api.github.com

# User web app — Google Sign-In (OAuth 2.0 web client ID)
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
